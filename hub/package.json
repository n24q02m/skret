{
  "name": "skret-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dryrun": "wrangler deploy --dry-run",
    "check": "biome check src test && oxfmt --check src test",
    "lint:ox": "oxlint src test",
    "fmt:check": "oxfmt --check src test"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ],
  "overrides": {
    "sharp": "^0.35.4",
    "wrangler": "^4.120.0",
    "ws": "^8.21.0",
    "undici": "^7.30.0",
    "siginfo": ">=2.0.0",
    "estree-walker": ">=3.0.0",
    "blake3-wasm": ">=2.0.0",
    "@jridgewell/trace-mapping": ">=0.3.0",
    "@jridgewell/resolve-uri": ">=3.1.0"
  }
}
