// wrangler.jsonc — skret vault-dashboard Worker (B3) + B2 cron sync container.
// The cron trigger starts a credential-free metadata planner; it does not
// forward provider credentials or Hub configuration into the container.
// Resource IDs are placeholders; real IDs are filled at deploy time from GH
// secrets into the gitignored wrangler.deploy.jsonc (see README).
// No routes / custom domain here — fully-BYO from commit one.
{
  "name": "skret-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-14",
  "kv_namespaces": [{ "binding": "VAULT_KV", "id": "<vault-kv-id>" }],
  // Rate limits for the two routes a stranger can reach. namespace_id is a
  // per-Worker counter id, not an account resource, so unlike the KV id these
  // are real values and not placeholders. `period` accepts only 10 or 60.
  // 30/min for ingest is far above `skret hub push`, which runs once a day on
  // the cron.
  //
  // LOGIN_LIMIT is NOT what enforces the 5/min on the login form -- measured
  // on the deployed Worker, a fresh connection per guess walks past it. The
  // LoginGate Durable Object below is the real counter; this stays as the
  // free first pass. See router.ts loginAllowed.
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "INGEST_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "containers": [
    {
      "name": "skret-sync",
      "class_name": "SyncContainer",
      // CF Containers pull only from the Cloudflare managed registry (an
      // external ghcr.io ref fails). Push the pre-built image first
      // (`wrangler containers push`), then fill <YOUR_ACCOUNT_ID>. Re-pushing
      // the SAME tag does NOT roll a running instance — bump the tag.
      "image": "registry.cloudflare.com/<YOUR_ACCOUNT_ID>/skret-sync:latest",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SYNC", "class_name": "SyncContainer" },
      { "name": "LOGIN_GATE", "class_name": "LoginGate" }
    ]
  },
  // Source-only service binding. The executor Worker has its own config and
  // replay Durable Object; deployment/readback remains explicitly gated.
  "services": [{ "binding": "EXECUTOR", "service": "skret-security-executor" }],
  // A new class needs its own tag; v1 is already applied and must stay
  // untouched, or the deploy is rejected as a rewritten migration history.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyncContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["LoginGate"] }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "observability": { "enabled": true }
}
