// Placeholder template for explicit local dry-run rendering. The variable
// names describe configuration shape only; no credential values are stored.
// Keep this file aligned with wrangler.jsonc while preserving placeholder
// values for every environment-specific identifier.
// Custom domains and other account-side state are intentionally outside this
// source bundle.
{
  "name": "skret-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-14",
  "kv_namespaces": [{ "binding": "VAULT_KV", "id": "${VAULT_KV_ID}" }],
  // Keep in step with wrangler.jsonc: Env declares both limiters as required,
  // so a rendered configuration without them fails at the first login rather
  // than silently serving an unlimited one. namespace_id is a per-Worker
  // counter id, not an account resource, so nothing is substituted here.
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "INGEST_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "containers": [
    {
      "name": "skret-sync",
      "class_name": "SyncContainer",
      "image": "${SKRET_SYNC_IMAGE}",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SYNC", "class_name": "SyncContainer" },
      { "name": "LOGIN_GATE", "class_name": "LoginGate" }
    ]
  },
  // Keep the ordinary Hub binding aligned with wrangler.jsonc. The paired
  // Worker config owns its replay Durable Object and remains source-only here.
  "services": [{ "binding": "EXECUTOR", "service": "skret-security-executor" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyncContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["LoginGate"] }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "observability": { "enabled": true }
}
