// Rendered at deploy time: envsubst fills ${VAULT_KV_ID} and ${SKRET_SYNC_IMAGE}
// from GH secrets into wrangler.deploy.jsonc (gitignored). 0 real IDs here.
//
// The custom domain (vault.n24q02m.com) is attached ONCE, out-of-band, to the
// Worker via `PUT /accounts/<acc>/workers/domains` (or the dashboard) — NOT via
// a `routes` block here. That keeps the CD deploy token least-privilege
// (account Workers Scripts + KV write only, no zone Workers-Routes permission):
// asserting a custom-domain route needs a zone-scoped policy, which the deploy
// token deliberately does not carry. The attached domain persists across script
// re-deploys, so CD never needs to touch it. See README "Hardening / deploy".
{
  "name": "skret-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-14",
  "kv_namespaces": [{ "binding": "VAULT_KV", "id": "${VAULT_KV_ID}" }],
  // Must stay in step with wrangler.jsonc: Env declares both limiters as
  // required, so a deploy rendered without them fails at the first login
  // rather than silently serving an unlimited one. namespace_id is a
  // per-Worker counter id, not an account resource -- nothing to envsubst.
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "INGEST_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "containers": [
    {
      "name": "skret-sync",
      "class_name": "SyncContainer",
      "image": "${SKRET_SYNC_IMAGE}",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SYNC", "class_name": "SyncContainer" },
      { "name": "LOGIN_GATE", "class_name": "LoginGate" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyncContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["LoginGate"] }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  // Non-secret var forwarded into the sync container (via index.ts SYNC_ENV_KEYS)
  // so the cloudflare sync target's account id resolves from env, keeping both
  // the committed config and the baked .skret.yaml free of the real account id.
  "vars": { "CLOUDFLARE_ACCOUNT_ID": "${CLOUDFLARE_ACCOUNT_ID}" },
  "observability": { "enabled": true }
}
