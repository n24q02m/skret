{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "before 5am every weekday"
  ],
  "prConcurrentLimit": 3,
  "semanticCommits": "enabled",
  "commitMessagePrefix": "fix(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "golang": {
    "postUpdateOptions": [
      "gomodTidy"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "pnpm"
      ],
      "allowedVersions": "<11",
      "description": "Hold pnpm <11. pnpm 11 makes ERR_PNPM_IGNORED_BUILDS (esbuild/sharp) fatal, breaking 'pnpm install --frozen-lockfile' in the docs Deploy Docs CD job."
    },
    {
      "description": "Pin GitHub Actions to SHA for security",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    }
  ]
}
