{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "before 5am every weekday"
  ],
  "prConcurrentLimit": 5,
  "semanticCommits": "enabled",
  "commitMessagePrefix": "fix(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "golang": {
    "postUpdateOptions": [
      "gomodTidy"
    ]
  },
  "packageRules": [
    {
      "description": "Hold every update for 7 days so a malicious or yanked release is caught before it lands",
      "matchPackageNames": [
        "*"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Pin GitHub Actions to SHA for security",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Automerge low-risk dependency updates (patch, digest, pin) once the 7-day release-age hold and all required checks pass",
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
